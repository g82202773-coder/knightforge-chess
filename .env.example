# Optional: Path to Stockfish UCI binary for engine analysis and AI opponent.
# On Debian/Ubuntu/Docker: /usr/games/stockfish
# On Windows: C:\path\to\stockfish.exe
STOCKFISH_PATH=

# SQLite database path for user accounts, ratings, saved games, and progress.
KNIGHTFORGE_DB_PATH=data/knightforge.db

# Curated opening repository & taxonomy paths.
KNIGHTFORGE_OPENINGS_PATH=data/openings/repository.json
KNIGHTFORGE_TAXONOMY_PATH=data/openings/opening_taxonomy.json

# In-memory active session/match TTL in seconds (default 7200 = 2 hours).
KNIGHTFORGE_SESSION_TTL_SECONDS=7200

# HTTP server port (used by Docker / Render).
PORT=8000
